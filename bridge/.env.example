# Copy to bridge/.env and fill in. The .env file is git-ignored.

# Where the Python agent listens (narwal_agent.py serve).
AGENT_URL=http://127.0.0.1:8799

# Optional shared secret. If you set config.agent.token in the Python config, set the SAME value here.
AGENT_TOKEN=

# The command group. Use EITHER the exact group subject (title) ...
GROUP_TITLE=Gimli
# ... OR the group JID (ends with @g.us). If set, GROUP_JID wins over GROUP_TITLE.
GROUP_JID=

# Where the WhatsApp linked-device credentials are stored (git-ignored).
AUTH_DIR=./auth
